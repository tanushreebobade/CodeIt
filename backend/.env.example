# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/codeit?retryWrites=true&w=majority

# JWT Configuration
# Generate a secure random string for production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API (AI Tutor)
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# OAuth Configuration (Optional)
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
# GITHUB_CLIENT_ID=your_github_client_id
# GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_CALLBACK_URL=http://localhost:5000/auth/github/callback

# Code Execution
# Code runs with the compilers installed on the server (g++, python, javac/java, node).
# Optional remote fallback for languages that are not installed locally:
# ONLINE_COMPILER_API_KEY=your_onlinecompiler_io_key

# Free-tier limits per problem
FREE_RUN_ATTEMPTS=10
FREE_SUBMIT_ATTEMPTS=5

# Bootstrap admin account (created on first start if missing). Alternatively run:
#   npm run create-admin -- admin@example.com yourpassword
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-password

# Cloudinary Configuration (Optional - for video uploads)
# Get these from: https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Configuration (Optional - token revocation on logout). Leave REDIS_HOST empty to disable.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# CORS Configuration
FRONTEND_URL=http://localhost:5173
